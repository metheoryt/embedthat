# python generated files
**/__pycache__
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
**/*.pyc

# env
.env
# IntelliJ Idea
.idea

# gortex-generated per-repo routing skills (re-sprayed by `gortex init`; keep out of git)
.claude/skills/generated/
.claude/settings.local.json

# Project memory lives in the agent-memory repo (~/.claude/memory/projects/
# metheoryt/embedthat/); .claude/memory is a symlink to it. No trailing slash: a
# `/`-suffixed pattern does not match a symlink.
.claude/memory

# Harvest state lives outside the repo: the watermark and review proposals in
# agent-memory (projects/metheoryt/embedthat/harvest/), run backups in
# ~/.local/state/memory-harvest/.
.claude/harvest
.claude/kb-harvest-state.json
