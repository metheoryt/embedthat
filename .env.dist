BOT_TOKEN=

# chat ID, where to dump video parts that will go into a media group
DUMP_CHAT_ID=

LOGLEVEL=INFO
REDIS_URL=redis://redis
# for logs to appear in local time
TZ=Asia/Almaty

# optional: chat ID where unhandled bot/worker errors get reported
ADMIN_CHAT_ID=

# optional: path to a Netscape-format cookies.txt handed to yt-dlp, which unlocks
# posts needing a logged-in session (Instagram reels, gated TikToks). Must be
# writable -- yt-dlp saves the refreshed jar back. Unset = no cookies.
COOKIES_FILE=

# optional: User-Agent sent only alongside the jar above -- copy the exact string
# of the browser that exported it, so the session is not replayed under a client
# it was never created in. Unset = yt-dlp's default (Windows Chrome).
COOKIES_USER_AGENT=

# optional: our own telegram-bot-api server (local mode) -- lifts the upload cap
# from 50 MB to 2000 MB. Unset or empty = Telegram's cloud server.
BOT_API_URL=
# credentials the telegram-bot-api service itself reads (my.telegram.org -> API)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
